/* =========================================================
   MASTER SAHAB
   COMPLETE SORTED STYLE SHEET
   Dashboard + Subjects + Goals + Progress + AI Chat
========================================================= */


/* =========================================================
   1. GLOBAL
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: "Segoe UI", Arial, sans-serif;
    color: #102a43;
    min-height: 100vh;

    background:
        radial-gradient(
            circle at 10% 10%,
            rgba(72, 160, 255, 0.25),
            transparent 30%
        ),
        radial-gradient(
            circle at 90% 20%,
            rgba(0, 119, 255, 0.18),
            transparent 30%
        ),
        radial-gradient(
            circle at 50% 100%,
            rgba(120, 200, 255, 0.22),
            transparent 35%
        ),
        linear-gradient(
            135deg,
            #f8fcff,
            #eaf6ff
        );

    overflow-x: hidden;
}

button {
    font-family: inherit;
    cursor: pointer;
}

input,
textarea,
button {
    font-family: inherit;
}

.page {
    display: none;
}

.active-page {
    display: block;
}


/* =========================================================
   2. APP LAYOUT
========================================================= */

.app {
    display: flex;
    min-height: 100vh;
}


/* =========================================================
   3. SIDEBAR
========================================================= */

.sidebar {
    width: 245px;
    min-height: 100vh;

    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;

    padding: 25px 15px;

    background: rgba(255, 255, 255, 0.55);

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    border-right: 1px solid rgba(255, 255, 255, 0.8);

    box-shadow:
        8px 0 30px rgba(30, 120, 200, 0.08);

    z-index: 100;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;

    padding: 5px 12px 35px;

    font-size: 20px;
    font-weight: 700;
}

.logo span {
    background: linear-gradient(
        90deg,
        #087eff,
        #00b7ff
    );

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 13px;

    width: 100%;

    padding: 14px 16px;

    border: 1px solid transparent;
    border-radius: 14px;

    background: transparent;

    color: #557089;

    text-align: left;
    font-size: 15px;

    transition: 0.25s ease;
}

.nav-item:hover {
    background: rgba(255, 255, 255, 0.65);
    border-color: rgba(0, 140, 255, 0.15);

    color: #087eff;

    transform: translateX(3px);
}

.nav-item.active {
    background: linear-gradient(
        135deg,
        rgba(0, 132, 255, 0.15),
        rgba(0, 190, 255, 0.10)
    );

    border-color: rgba(0, 132, 255, 0.20);

    color: #087eff;

    box-shadow:
        0 8px 25px rgba(0, 130, 255, 0.10);
}

.sidebar-bottom {
    position: absolute;

    bottom: 25px;
    left: 25px;
}

.online-small {
    color: #6c8297;
    font-size: 13px;
}

.online-small span {
    display: inline-block;

    width: 8px;
    height: 8px;

    margin-right: 6px;

    border-radius: 50%;

    background: #20c997;

    box-shadow:
        0 0 10px rgba(32, 201, 151, 0.5);
}


/* =========================================================
   4. MAIN CONTENT
========================================================= */

.main-content {
    width: calc(100% - 245px);
    min-height: 100vh;

    margin-left: 245px;
    padding: 35px;
}


/* =========================================================
   5. COMMON PAGE HEADER
========================================================= */

.simple-page-header {
    margin-bottom: 30px;
}

.simple-page-header h1 {
    margin-bottom: 8px;

    color: #123b58;
    font-size: 30px;
}

.simple-page-header p {
    color: #71869a;
}


/* =========================================================
   6. DASHBOARD - WELCOME
========================================================= */

.dashboard-welcome {
    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 20px;

    margin-bottom: 25px;
    padding: 28px;

    border-radius: 22px;

    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,0.96),
            rgba(239,246,255,0.88)
        );

    border: 1px solid rgba(37,99,235,0.10);

    box-shadow:
        0 12px 35px rgba(30,64,175,0.08);
}

.welcome-badge {
    display: inline-block;

    padding: 7px 13px;

    border-radius: 30px;

    background: #dbeafe;
    color: #1d4ed8;

    font-size: 12px;
    font-weight: 700;
}

.welcome-content h1 {
    margin-top: 10px;

    color: #102a43;
    font-size: 30px;
}

.welcome-content p {
    margin-top: 8px;

    color: #627d98;
    font-size: 14px;
}

.welcome-date {
    text-align: right;
    color: #627d98;
}

.welcome-date span {
    display: block;
    font-size: 13px;
}

.welcome-date strong {
    display: block;

    margin-top: 5px;

    color: #102a43;
    font-size: 15px;
}


/* =========================================================
   7. DASHBOARD - STATS
========================================================= */

.dashboard-stats,
.stats-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 18px;

    margin-bottom: 22px;
}

.stat-card {
    position: relative;

    display: flex;
    align-items: center;

    gap: 15px;

    padding: 20px;

    overflow: hidden;

    border-radius: 18px;

    background: rgba(255,255,255,0.88);

    border: 1px solid rgba(0,0,0,0.05);

    box-shadow:
        0 8px 25px rgba(15,23,42,0.06);

    transition: 0.25s ease;
}

.stat-card:hover {
    transform: translateY(-5px);

    box-shadow:
        0 15px 35px rgba(15,23,42,0.11);
}

.stat-card::after {
    content: "";

    position: absolute;

    width: 70px;
    height: 70px;

    right: -25px;
    top: -25px;

    border-radius: 50%;

    background: rgba(255,255,255,0.35);
}

.stat-icon {
    width: 52px;
    height: 52px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 15px;

    background: rgba(255,255,255,0.7);

    font-size: 25px;
}

.stat-blue .stat-icon {
    background: #dbeafe;
}

.stat-green .stat-icon {
    background: #dcfce7;
}

.stat-orange .stat-icon {
    background: #ffedd5;
}

.stat-purple .stat-icon {
    background: #ede9fe;
}

.stat-info span {
    display: block;

    color: #627d98;

    font-size: 12px;
    font-weight: 600;
}

.stat-info strong {
    display: block;

    margin: 2px 0;

    color: #102a43;

    font-size: 25px;
}

.stat-info small {
    color: #829ab1;
    font-size: 11px;
}


/* =========================================================
   8. DASHBOARD - CARDS & GRID
========================================================= */

.dashboard-main-grid {
    display: grid;

    grid-template-columns: 1.15fr 0.85fr;

    gap: 20px;

    margin-bottom: 20px;
}

.dashboard-bottom-grid {
    display: grid;

    grid-template-columns: 1.1fr 0.9fr 0.9fr;

    gap: 20px;
}

.dashboard-grid {
    display: grid;

    grid-template-columns: 1.4fr 1fr;

    gap: 20px;

    margin-bottom: 20px;
}

.dashboard-card {
    padding: 22px;

    border-radius: 20px;

    background: rgba(255,255,255,0.88);

    border: 1px solid rgba(0,0,0,0.05);

    box-shadow:
        0 8px 28px rgba(15,23,42,0.06);

    transition: 0.25s ease;
}

.dashboard-card:hover {
    box-shadow:
        0 14px 35px rgba(15,23,42,0.09);
}

.card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    margin-bottom: 20px;
}

.card-heading h2 {
    margin: 4px 0 0;

    color: #102a43;
    font-size: 19px;
}

.card-heading p {
    color: #7a8fa3;
    font-size: 13px;
}

.card-label {
    color: #2563eb;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 1px;
}


/* =========================================================
   9. STUDY ITEMS
========================================================= */

.study-item {
    display: flex;
    align-items: center;

    gap: 14px;

    padding: 15px;
    margin-bottom: 10px;

    border-radius: 14px;

    background: rgba(255,255,255,0.48);

    border: 1px solid rgba(255,255,255,0.7);

    transition: 0.25s;
}

.study-item:hover {
    background: rgba(255,255,255,0.75);

    transform: translateX(3px);
}

.subject-icon {
    font-size: 25px;
}

.study-info {
    flex: 1;
}

.study-info h3 {
    margin-bottom: 4px;

    color: #183d57;
    font-size: 15px;
}

.study-info p {
    color: #7b90a4;
    font-size: 12px;
}

.study-time {
    color: #087eff;

    font-size: 13px;
    font-weight: 600;
}


/* =========================================================
   10. GOALS - DASHBOARD
========================================================= */

.goal {
    margin-bottom: 22px;
}

.goal-top {
    display: flex;
    justify-content: space-between;

    margin-bottom: 9px;

    color: #45647c;
    font-size: 14px;
}

.goal-top strong {
    color: #087eff;
}

.progress-bar {
    height: 8px;

    overflow: hidden;

    border-radius: 10px;

    background: rgba(0,100,180,0.09);
}

.progress-fill {
    height: 100%;

    border-radius: 10px;

    background:
        linear-gradient(
            90deg,
            #087eff,
            #00c6ff
        );

    box-shadow:
        0 0 12px rgba(0,150,255,0.25);
}

.goal-percentage {
    padding: 7px 12px;

    border-radius: 20px;

    background: #dbeafe;
    color: #2563eb;

    font-size: 13px;
    font-weight: 700;
}

.goal-progress-wrapper {
    margin-bottom: 18px;
}

.goal-progress {
    width: 100%;
    height: 10px;

    overflow: hidden;

    border-radius: 20px;

    background: #e8eef5;
}

.goal-progress-fill {
    width: 0%;
    height: 100%;

    border-radius: inherit;

    background:
        linear-gradient(
            90deg,
            #2563eb,
            #60a5fa
        );

    transition: width 0.5s ease;
}

#goal-progress-text {
    display: block;

    margin-top: 8px;

    color: #829ab1;
    font-size: 12px;
}

.dashboard-goal-list {
    display: flex;
    flex-direction: column;

    gap: 9px;

    max-height: 210px;

    overflow-y: auto;
}

.dashboard-goal-item {
    display: flex;
    align-items: center;

    gap: 10px;

    padding: 11px;

    border-radius: 12px;

    background: #f8fafc;

    border: 1px solid #edf2f7;
}

.dashboard-goal-item.completed {
    opacity: 0.65;
}

.dashboard-goal-item input {
    width: 17px;
    height: 17px;

    accent-color: #2563eb;

    cursor: pointer;
}

.dashboard-goal-item span {
    color: #243b53;
    font-size: 13px;
}

.streak {
    margin-top: 25px;
    padding: 15px;

    border-radius: 14px;

    background: rgba(255,255,255,0.55);

    border: 1px solid rgba(255,255,255,0.7);

    color: #45647c;
}

.streak strong {
    margin-left: 6px;
    color: #183d57;
}

.streak span {
    display: block;

    margin-top: 5px;
    margin-left: 28px;

    color: #8295a7;

    font-size: 12px;
}


/* =========================================================
   11. QUICK ACTIONS
========================================================= */

.quick-actions {
    margin-bottom: 30px;
}

.action-grid,
.quick-action-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 11px;
}

.action-grid button,
.quick-action {
    border: 1px solid #edf2f7;

    border-radius: 13px;

    background: #f8fafc;

    color: #183d57;

    transition: 0.22s ease;
}

.action-grid button {
    padding: 18px;

    text-align: left;
}

.action-grid button:hover,
.quick-action:hover {
    background: #eef5ff;

    border-color: #bfdbfe;

    transform: translateY(-2px);

    box-shadow:
        0 10px 25px rgba(40,130,200,0.10);
}

.action-grid span {
    display: block;

    margin-bottom: 12px;

    font-size: 26px;
}

.action-grid strong {
    display: block;

    margin-bottom: 5px;

    font-size: 14px;
}

.action-grid small {
    color: #8295a7;
}

.quick-action {
    display: flex;
    align-items: center;

    width: 100%;

    gap: 10px;

    padding: 13px;

    text-align: left;
}

.quick-action-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 10px;

    background: white;

    font-size: 19px;
}

.quick-action div {
    min-width: 0;
    flex: 1;
}

.quick-action strong {
    display: block;

    color: #102a43;
    font-size: 12px;
}

.quick-action small {
    display: block;

    margin-top: 3px;

    color: #829ab1;
    font-size: 10px;
}

.action-arrow {
    color: #2563eb;
    font-size: 18px;
}


/* =========================================================
   12. DASHBOARD SUBJECTS
========================================================= */

.dashboard-subjects {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 10px;
}

.dashboard-subject {
    padding: 13px;

    border-radius: 13px;

    background: #f8fafc;

    border: 1px solid #edf2f7;

    cursor: pointer;

    transition: 0.2s;
}

.dashboard-subject:hover {
    background: #eef5ff;

    border-color: #bfdbfe;

    transform: translateY(-2px);
}

.dashboard-subject-top {
    display: flex;
    align-items: center;

    gap: 9px;
}

.dashboard-subject-icon {
    font-size: 23px;
}

.dashboard-subject-name {
    color: #102a43;

    font-size: 13px;
    font-weight: 700;
}

.dashboard-subject-progress {
    height: 6px;

    margin-top: 10px;

    overflow: hidden;

    border-radius: 10px;

    background: #e8eef5;
}

.dashboard-subject-progress span {
    display: block;

    width: 0%;
    height: 100%;

    border-radius: inherit;

    background: #2563eb;
}


/* =========================================================
   13. DASHBOARD MOTIVATION
========================================================= */

.motivation-card {
    position: relative;

    overflow: hidden;

    background:
        linear-gradient(
            145deg,
            #eff6ff,
            #ffffff
        );
}

.motivation-icon {
    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 15px;

    border-radius: 14px;

    background: #dbeafe;

    font-size: 24px;
}

.motivation-card h2 {
    margin: 9px 0;

    color: #102a43;

    font-size: 18px;
    line-height: 1.4;
}

.motivation-card p {
    color: #627d98;

    font-size: 12px;
    line-height: 1.6;
}

.motivation-btn {
    margin-top: 16px;

    padding: 9px 13px;

    border: 0;
    border-radius: 9px;

    background: #2563eb;
    color: white;

    font-size: 11px;

    transition: 0.2s;
}

.motivation-btn:hover {
    background: #1d4ed8;

    transform: translateY(-1px);
}


/* =========================================================
   14. DASHBOARD ACTIVITY
========================================================= */

.dashboard-activity {
    display: flex;
    flex-direction: column;

    gap: 10px;

    max-height: 190px;

    overflow-y: auto;
}

.activity-item {
    display: flex;
    align-items: center;

    gap: 10px;

    padding: 10px;

    border-radius: 11px;

    background: #f8fafc;
}

.activity-icon {
    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 9px;

    background: #dbeafe;
}

.activity-text {
    flex: 1;
}

.activity-text strong {
    display: block;

    color: #243b53;

    font-size: 12px;
}

.activity-text small {
    color: #829ab1;
    font-size: 10px;
}

.activity-empty {
    padding: 30px 10px;

    text-align: center;

    color: #829ab1;

    font-size: 12px;
}


/* =========================================================
   15. DASHBOARD EMPTY
========================================================= */

.dashboard-empty {
    padding: 22px 10px;

    text-align: center;

    color: #829ab1;
}

.dashboard-empty span {
    display: block;

    margin-bottom: 7px;

    font-size: 30px;
}

.dashboard-empty p {
    margin-bottom: 10px;

    font-size: 13px;
}

.dashboard-empty button {
    border: none;

    padding: 9px 14px;

    border-radius: 9px;

    background: #2563eb;

    color: white;
}


/* =========================================================
   16. AI BANNER
========================================================= */

.dashboard-ai-banner {
    display: flex;
    align-items: center;

    gap: 18px;

    margin-top: 20px;
    padding: 23px;

    border-radius: 20px;

    background:
        linear-gradient(
            135deg,
            #172554,
            #2563eb
        );

    color: white;

    box-shadow:
        0 15px 35px rgba(37,99,235,0.20);
}

.ai-banner-icon {
    width: 55px;
    height: 55px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 16px;

    background: rgba(255,255,255,0.15);

    font-size: 27px;
}

.ai-banner-text {
    flex: 1;
}

.ai-banner-text span {
    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 1px;

    opacity: 0.75;
}

.ai-banner-text h2 {
    margin: 4px 0;

    font-size: 19px;
}

.ai-banner-text p {
    font-size: 12px;

    opacity: 0.8;
}

.ai-banner-btn {
    display: flex;
    align-items: center;

    gap: 10px;

    padding: 11px 17px;

    border: none;
    border-radius: 10px;

    background: white;
    color: #1d4ed8;

    font-weight: 700;

    transition: 0.2s;
}

.ai-banner-btn:hover {
    transform: translateY(-2px);
}


/* =========================================================
   17. SUBJECTS PAGE
========================================================= */

.subjects-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 20px;

    margin-bottom: 25px;
}

.subjects-badge {
    display: inline-block;

    padding: 6px 11px;

    border-radius: 20px;

    background: #dbeafe;
    color: #2563eb;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 1px;
}

.subjects-header h1 {
    margin-top: 9px;

    color: #102a43;

    font-size: 30px;
}

.subjects-header p {
    margin-top: 6px;

    color: #71869a;

    font-size: 14px;
}

.add-subject-main-btn {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 13px 18px;

    border: none;
    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #0ea5e9
        );

    color: white;

    font-size: 14px;
    font-weight: 700;

    box-shadow:
        0 8px 20px rgba(37,99,235,0.20);

    transition: 0.2s;
}

.add-subject-main-btn:hover {
    transform: translateY(-2px);

    box-shadow:
        0 12px 25px rgba(37,99,235,0.28);
}

.add-subject-main-btn span {
    font-size: 20px;
}


/* =========================================================
   18. SUBJECT TOOLBAR
========================================================= */

.subjects-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    margin-bottom: 20px;
}

.subject-search-box {
    display: flex;
    align-items: center;

    gap: 10px;

    flex: 1;

    max-width: 500px;

    padding: 12px 15px;

    border-radius: 13px;

    background: rgba(255,255,255,0.85);

    border: 1px solid #e1eaf2;

    box-shadow:
        0 6px 20px rgba(30,64,175,0.05);
}

.subject-search-box span {
    font-size: 17px;
}

.subject-search-box input {
    width: 100%;

    border: none;
    outline: none;

    background: transparent;

    color: #102a43;

    font-size: 14px;
}

.subject-search-box input::placeholder {
    color: #9aabba;
}

.subject-count-box {
    display: flex;
    align-items: center;

    gap: 7px;

    padding: 10px 15px;

    border-radius: 12px;

    background: white;

    border: 1px solid #e5edf5;
}

.subject-count-box strong {
    color: #2563eb;

    font-size: 18px;
}

.subject-count-box span {
    color: #71869a;

    font-size: 12px;
}


/* =========================================================
   19. SUBJECT GRID
========================================================= */

.enhanced-subject-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 18px;
}

.enhanced-subject-card {
    position: relative;

    overflow: hidden;

    padding: 20px;

    border-radius: 20px;

    background: rgba(255,255,255,0.90);

    border: 1px solid rgba(255,255,255,0.95);

    box-shadow:
        0 10px 30px rgba(30,64,175,0.07);

    transition: 0.25s ease;
}

.enhanced-subject-card:hover {
    transform: translateY(-5px);

    box-shadow:
        0 16px 35px rgba(30,64,175,0.12);
}

.enhanced-subject-top {
    display: flex;
    align-items: flex-start;

    gap: 13px;
}

.enhanced-subject-icon {
    width: 55px;
    height: 55px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 15px;

    background: #eff6ff;

    font-size: 29px;
}

.enhanced-subject-info {
    flex: 1;
    min-width: 0;
}

.enhanced-subject-info h2 {
    margin-bottom: 5px;

    color: #102a43;

    font-size: 17px;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}

.enhanced-subject-info p {
    color: #829ab1;

    font-size: 11px;

    line-height: 1.4;
}

.subject-menu {
    display: flex;
    gap: 4px;
}

.subject-menu button {
    width: 30px;
    height: 30px;

    border: none;
    border-radius: 8px;

    background: #f4f7fb;

    color: #627d98;

    font-size: 13px;
}

.subject-menu button:hover {
    background: #dbeafe;
    color: #2563eb;
}

.subject-menu .delete-subject:hover {
    background: #fee2e2;
    color: #dc2626;
}


/* =========================================================
   20. SUBJECT PROGRESS
========================================================= */

.subject-progress-section {
    margin-top: 20px;
}

.subject-progress-top {
    display: flex;
    justify-content: space-between;

    margin-bottom: 7px;
}

.subject-progress-top span {
    color: #627d98;

    font-size: 11px;
}

.subject-progress-top strong {
    color: #2563eb;

    font-size: 12px;
}

.subject-progress-bar {
    height: 8px;

    overflow: hidden;

    border-radius: 20px;

    background: #e8eef5;
}

.subject-progress-bar span {
    display: block;

    width: 0%;
    height: 100%;

    border-radius: inherit;

    background:
        linear-gradient(
            90deg,
            #2563eb,
            #38bdf8
        );

    transition: width 0.4s ease;
}


/* =========================================================
   21. SUBJECT CARD FOOTER
========================================================= */

.subject-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-top: 17px;
    padding-top: 14px;

    border-top: 1px solid #edf2f7;
}

.subject-card-stat {
    color: #829ab1;

    font-size: 11px;
}

.subject-card-stat strong {
    color: #243b53;
}

.open-subject-btn {
    border: none;

    background: transparent;

    color: #2563eb;

    font-size: 11px;
    font-weight: 700;
}

.open-subject-btn:hover {
    text-decoration: underline;
}


/* =========================================================
   22. SUBJECT EMPTY STATE
========================================================= */

.subjects-empty {
    padding: 60px 20px;

    text-align: center;

    border-radius: 20px;

    background: rgba(255,255,255,0.65);

    border: 1px dashed #cbd5e1;
}

.subjects-empty-icon {
    margin-bottom: 12px;

    font-size: 55px;
}

.subjects-empty h2 {
    color: #102a43;

    font-size: 21px;
}

.subjects-empty p {
    margin: 7px 0 18px;

    color: #829ab1;

    font-size: 13px;
}

.subjects-empty button {
    border: none;

    padding: 10px 16px;

    border-radius: 10px;

    background: #2563eb;

    color: white;

    font-weight: 600;
}


/* =========================================================
   23. SUBJECT MODAL
========================================================= */

.subject-modal {
    position: fixed;

    inset: 0;

    z-index: 1000;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(15,23,42,0.38);

    backdrop-filter: blur(7px);
}

.subject-modal.show {
    display: flex;
}

.subject-modal-box,
.subject-details-box {
    width: min(680px, 100%);

    max-height: 90vh;

    overflow-y: auto;

    border-radius: 22px;

    background: rgba(255,255,255,0.97);

    box-shadow:
        0 25px 70px rgba(15,23,42,0.20);
}

.subject-modal-box {
    padding: 25px;
}

.subject-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 22px;
}

.subject-modal-header span {
    color: #2563eb;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 1px;
}

.subject-modal-header h2 {
    margin-top: 6px;

    color: #102a43;

    font-size: 22px;
}

.subject-modal-close {
    width: 35px;
    height: 35px;

    border: none;
    border-radius: 10px;

    background: #f1f5f9;

    color: #627d98;

    font-size: 23px;
}

.subject-modal-close:hover {
    background: #fee2e2;
    color: #dc2626;
}


/* =========================================================
   24. SUBJECT FORM
========================================================= */

.subject-form {
    display: flex;
    flex-direction: column;

    gap: 18px;
}

.form-group {
    display: flex;
    flex-direction: column;

    gap: 8px;
}

.form-group label {
    color: #243b53;

    font-size: 13px;
    font-weight: 700;
}

.form-group input,
.form-group textarea {
    width: 100%;

    padding: 11px 12px;

    border: 1px solid #d9e2ec;
    border-radius: 11px;

    outline: none;

    background: #f8fafc;

    color: #243b53;

    font-size: 13px;
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: #60a5fa;

    background: white;

    box-shadow:
        0 0 0 3px rgba(37,99,235,0.07);
}

.form-group textarea {
    resize: vertical;
}

.form-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;
}

.small-add-btn {
    padding: 6px 9px;

    border: none;
    border-radius: 7px;

    background: #dbeafe;

    color: #2563eb;

    font-size: 10px;
    font-weight: 700;
}


/* =========================================================
   25. SUBJECT EMOJI SELECTOR
========================================================= */

.emoji-selector {
    display: flex;
    flex-wrap: wrap;

    gap: 7px;
}

.emoji-selector button {
    width: 38px;
    height: 38px;

    border: 1px solid #e2e8f0;

    border-radius: 9px;

    background: #f8fafc;

    font-size: 19px;
}

.emoji-selector button:hover {
    background: #dbeafe;

    border-color: #93c5fd;
}


/* =========================================================
   26. DYNAMIC INPUTS
========================================================= */

.dynamic-input-list {
    display: flex;
    flex-direction: column;

    gap: 8px;
}

.dynamic-input-row {
    display: flex;

    gap: 7px;
}

.dynamic-input-row input {
    flex: 1;
}

.remove-input-btn {
    width: 38px;

    border: none;

    border-radius: 9px;

    background: #fee2e2;

    color: #dc2626;

    font-size: 15px;
}


/* =========================================================
   27. SUBJECT MODAL FOOTER
========================================================= */

.subject-modal-footer {
    display: flex;
    justify-content: flex-end;

    gap: 10px;

    margin-top: 25px;
    padding-top: 18px;

    border-top: 1px solid #edf2f7;
}

.cancel-subject-btn,
.save-subject-btn {
    padding: 11px 16px;

    border: none;

    border-radius: 10px;

    font-weight: 600;
}

.cancel-subject-btn {
    background: #f1f5f9;

    color: #627d98;
}

.save-subject-btn {
    background: #2563eb;

    color: white;
}

.save-subject-btn:hover {
    background: #1d4ed8;
}


/* =========================================================
   28. SUBJECT DETAILS
========================================================= */

.subject-details-box {
    position: relative;

    padding: 28px;
}

.subject-detail-header {
    display: flex;
    align-items: center;

    gap: 15px;

    padding-right: 35px;
}

.subject-detail-icon {
    width: 65px;
    height: 65px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 17px;

    background: #dbeafe;

    font-size: 34px;
}

.subject-detail-header h2 {
    color: #102a43;

    font-size: 23px;
}

.subject-detail-header p {
    margin-top: 4px;

    color: #829ab1;

    font-size: 12px;
}

.detail-progress {
    margin: 22px 0;

    padding: 17px;

    border-radius: 14px;

    background: #f8fafc;
}

.detail-progress-top {
    display: flex;
    justify-content: space-between;

    margin-bottom: 8px;
}

.detail-progress-top strong {
    color: #2563eb;
}

.detail-section {
    margin-top: 22px;
}

.detail-section h3 {
    margin-bottom: 11px;

    color: #243b53;

    font-size: 15px;
}

.syllabus-item,
.topic-item {
    display: flex;
    align-items: center;

    gap: 9px;

    padding: 10px 12px;
    margin-bottom: 7px;

    border-radius: 10px;

    background: #f8fafc;

    border: 1px solid #edf2f7;

    color: #40566d;

    font-size: 12px;
}

.topic-item.completed {
    color: #829ab1;

    text-decoration: line-through;

    opacity: 0.7;
}

.topic-check {
    width: 16px;
    height: 16px;

    accent-color: #2563eb;
}


/* =========================================================
   29. CHAT PAGE
========================================================= */

#chat-page {
    width: 100%;
    height: 100%;

    padding: 0 !important;

    overflow: hidden;
}

.chat-layout {
    display: flex;

    width: 100%;
    height: 100%;

    min-height: 0;

    overflow: hidden;
}


/* =========================================================
   30. CHAT HISTORY
========================================================= */

#chat-page .chat-history {
    order: 1;

    flex: 0 0 280px;

    width: 280px;
    min-width: 280px;
    height: 100%;

    display: flex;
    flex-direction: column;

    padding: 18px;

    background: rgba(255,255,255,0.88);

    border-right: 1px solid rgba(0,0,0,0.08);

    backdrop-filter: blur(15px);
}

.history-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 8px;

    margin-bottom: 15px;
}

.history-header h2 {
    color: #102a43;

    font-size: 20px;
}

.new-chat-btn {
    border: none;

    padding: 8px 12px;

    border-radius: 9px;

    background: #2563eb;

    color: white;

    font-size: 13px;

    transition: 0.2s;
}

.new-chat-btn:hover {
    background: #1d4ed8;

    transform: translateY(-1px);
}

.history-search {
    margin-bottom: 15px;
}

.history-search input {
    width: 100%;

    padding: 11px 12px;

    border: 1px solid #d9e2ec;

    border-radius: 10px;

    outline: none;

    background: white;

    font-size: 14px;
}

.history-search input:focus {
    border-color: #2563eb;
}

.history-list {
    display: flex;
    flex-direction: column;

    flex: 1;

    gap: 8px;

    overflow-y: auto;
}

.history-item {
    position: relative;

    padding: 12px 38px 12px 12px;

    border-radius: 10px;

    background: rgba(255,255,255,0.75);

    border: 1px solid transparent;

    cursor: pointer;

    transition: 0.2s;
}

.history-item:hover {
    background: #eef5ff;

    border-color: #bfdbfe;
}

.history-item.active {
    background: #dbeafe;

    border-color: #93c5fd;
}

.history-title {
    overflow: hidden;

    color: #102a43;

    font-size: 14px;
    font-weight: 600;

    white-space: nowrap;

    text-overflow: ellipsis;
}

.history-date {
    margin-top: 4px;

    color: #829ab1;

    font-size: 11px;
}

.history-delete {
    position: absolute;

    right: 8px;
    top: 50%;

    transform: translateY(-50%);

    border: none;

    background: transparent;

    font-size: 15px;

    opacity: 0.6;
}

.history-delete:hover {
    opacity: 1;
}

.history-empty {
    padding: 30px 10px;

    text-align: center;

    color: #829ab1;

    font-size: 13px;
}


/* =========================================================
   31. CHAT MAIN
========================================================= */

#chat-page .chat-wrapper {
    order: 2;

    flex: 1 1 auto;

    width: auto;
    min-width: 0;
    height: 100%;

    display: flex;
    flex-direction: column;

    padding: 10px 20px 20px;

    background: rgba(255,255,255,0.35);

    backdrop-filter: blur(20px);

    border: 1px solid rgba(255,255,255,0.75);

    border-radius: 22px;

    box-shadow:
        0 15px 40px rgba(40,130,200,0.10);
}

#chat-page .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    flex-shrink: 0;

    padding: 15px 5px 20px;
}

.chat-header h1 {
    color: #123b58;

    font-size: 24px;
}

.chat-header p {
    margin-top: 4px;

    color: #7890a4;

    font-size: 13px;
}

.online-dot {
    display: inline-block;

    width: 7px;
    height: 7px;

    margin-right: 5px;

    border-radius: 50%;

    background: #20c997;

    box-shadow:
        0 0 8px rgba(32,201,151,0.5);
}

.clear-btn {
    padding: 9px 14px;

    border: 1px solid rgba(255,255,255,0.8);

    border-radius: 10px;

    background: rgba(255,255,255,0.55);

    color: #587188;

    transition: 0.2s;
}

.clear-btn:hover {
    background: rgba(255,255,255,0.8);

    color: #087eff;
}


/* =========================================================
   32. CHAT MESSAGES
========================================================= */

#chat-page .chat-box {
    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 25px 15px;
}

.message {
    max-width: 78%;

    margin-bottom: 15px;
    padding: 13px 16px;

    border-radius: 15px;

    line-height: 1.5;

    box-shadow:
        0 5px 15px rgba(30,100,160,0.05);
}

.user-message {
    margin-left: auto;

    background:
        linear-gradient(
            135deg,
            rgba(0,132,255,0.15),
            rgba(0,195,255,0.12)
        );

    border: 1px solid rgba(0,140,255,0.12);

    color: #164462;
}

.bot-message {
    background: rgba(255,255,255,0.65);

    border: 1px solid rgba(255,255,255,0.8);

    color: #294b63;
}


/* =========================================================
   33. CHAT INPUT
========================================================= */

#chat-page .input-area {
    display: flex;

    flex-shrink: 0;

    gap: 10px;

    padding-top: 15px;
}

.input-area input[type="text"] {
    flex: 1;

    padding: 14px;

    border: 1px solid rgba(255,255,255,0.85);

    border-radius: 13px;

    outline: none;

    background: rgba(255,255,255,0.62);

    color: #183d57;

    font-size: 15px;

    box-shadow:
        inset 0 2px 10px rgba(50,130,180,0.04);
}

.input-area input[type="text"]::placeholder {
    color: #91a4b5;
}

.input-area input[type="text"]:focus {
    border-color: rgba(0,132,255,0.3);

    box-shadow:
        0 0 0 3px rgba(0,132,255,0.06),
        inset 0 2px 10px rgba(50,130,180,0.04);
}

#send-btn {
    width: 52px;

    border: none;

    border-radius: 13px;

    background:
        linear-gradient(
            135deg,
            #087eff,
            #00b9ff
        );

    color: white;

    font-size: 20px;

    box-shadow:
        0 8px 20px rgba(0,130,255,0.20);

    transition: 0.2s;
}

#send-btn:hover {
    transform: translateY(-2px);

    box-shadow:
        0 12px 25px rgba(0,130,255,0.28);
}


/* =========================================================
   34. PLUS MENU
========================================================= */

.plus-menu-container {
    position: relative;
}

.plus-btn {
    width: 48px;
    height: 48px;

    border: 1px solid rgba(255,255,255,0.8);

    border-radius: 13px;

    background: rgba(255,255,255,0.60);

    color: #087eff;

    font-size: 26px;

    transition: 0.2s;
}

.plus-btn:hover {
    background: rgba(255,255,255,0.85);

    transform: rotate(90deg);
}

.plus-menu {
    position: absolute;

    left: 0;
    bottom: 58px;

    display: none;

    width: 160px;

    padding: 8px;

    border: 1px solid rgba(255,255,255,0.9);

    border-radius: 14px;

    background: rgba(255,255,255,0.88);

    backdrop-filter: blur(20px);

    box-shadow:
        0 15px 40px rgba(30,100,160,0.15);
}

.plus-menu.show {
    display: block;
}

.menu-option {
    display: flex;
    align-items: center;

    width: 100%;

    gap: 10px;

    padding: 11px;

    border: none;

    border-radius: 9px;

    background: transparent;

    color: #31546d;

    text-align: left;
}

.menu-option:hover {
    background: rgba(0,132,255,0.08);

    color: #087eff;
}

.menu-icon {
    font-size: 18px;
}


/* =========================================================
   35. GOALS PAGE
========================================================= */

.large-goal {
    display: flex;
    align-items: center;

    gap: 18px;

    margin-bottom: 20px;
}

.large-goal span {
    font-size: 35px;
}

.large-goal div {
    flex: 1;
}

.large-goal h2 {
    margin-bottom: 5px;

    color: #183d57;

    font-size: 18px;
}

.large-goal p {
    color: #7b90a4;

    font-size: 13px;
}

.large-goal strong {
    color: #087eff;

    font-size: 18px;
}

.progress-bar.large {
    height: 12px;
}


/* =========================================================
   36. PROGRESS PAGE
========================================================= */

.progress-cards {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 20px;
}

.progress-stat {
    padding: 30px;

    border-radius: 18px;

    background: rgba(255,255,255,0.55);

    border: 1px solid rgba(255,255,255,0.85);

    box-shadow:
        0 10px 30px rgba(40,130,200,0.08);

    text-align: center;
}

.progress-stat span {
    font-size: 35px;
}

.progress-stat h2 {
    margin: 12px 0 5px;

    color: #123b58;

    font-size: 30px;
}

.progress-stat p {
    color: #7b90a4;
}


/* =========================================================
   37. VIEW ALL
========================================================= */

.view-all-btn {
    border: none;

    background: transparent;

    color: #2563eb;

    font-size: 11px;
    font-weight: 700;
}


/* =========================================================
   38. SCROLLBAR
========================================================= */

::-webkit-scrollbar {
    width: 7px;
    height: 7px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    border-radius: 10px;

    background: rgba(0,130,255,0.20);
}


/* =========================================================
   39. RESPONSIVE - 1100px
========================================================= */

@media (max-width: 1100px) {

    .dashboard-stats,
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .dashboard-bottom-grid {
        grid-template-columns: 1fr 1fr;
    }

    .activity-card {
        grid-column: span 2;
    }

    .enhanced-subject-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}


/* =========================================================
   40. RESPONSIVE - 900px
========================================================= */

@media (max-width: 900px) {

    .sidebar {
        width: 75px;
    }

    .logo span,
    .nav-item span {
        display: none;
    }

    .logo {
        justify-content: center;

        padding-left: 0;
        padding-right: 0;
    }

    .nav-item {
        justify-content: center;

        font-size: 20px;
    }

    .main-content {
        width: calc(100% - 75px);

        margin-left: 75px;

        padding: 20px;
    }

    .dashboard-main-grid,
    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .action-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}


/* =========================================================
   41. RESPONSIVE - 800px
========================================================= */

@media (max-width: 800px) {

    .dashboard-bottom-grid {
        grid-template-columns: 1fr;
    }

    .activity-card {
        grid-column: auto;
    }

    .dashboard-welcome {
        flex-direction: column;

        align-items: flex-start;
    }

    .welcome-date {
        text-align: left;
    }

    .subjects-header {
        flex-direction: column;

        align-items: flex-start;
    }

    .add-subject-main-btn {
        width: 100%;
    }

    .subject-search-box {
        max-width: none;
    }

}


/* =========================================================
   42. RESPONSIVE - 768px
========================================================= */

@media (max-width: 768px) {

    #chat-page .chat-history {
        flex: 0 0 220px;

        width: 220px;
        min-width: 220px;
    }

    #chat-page .chat-box {
        padding: 15px;
    }

}


/* =========================================================
   43. RESPONSIVE - 700px
========================================================= */

@media (max-width: 700px) {

    .subjects-toolbar {
        align-items: stretch;
    }

    .enhanced-subject-grid {
        grid-template-columns: 1fr;
    }

}


/* =========================================================
   44. RESPONSIVE - 600px
========================================================= */

@media (max-width: 600px) {

    .main-content {
        padding: 12px;
    }

    .dashboard-header {
        display: block;
    }

    .dashboard-header h1 {
        font-size: 24px;
    }

    .date-box {
        display: inline-block;

        margin-top: 15px;
    }

    .dashboard-stats,
    .stats-grid {
        grid-template-columns: 1fr;
    }

    .action-grid,
    .progress-cards {
        grid-template-columns: 1fr;
    }

    .dashboard-subjects {
        grid-template-columns: 1fr;
    }

    .chat-wrapper {
        height: calc(100vh - 25px);
    }

    .message {
        max-width: 90%;
    }

    #chat-page .chat-history {
        flex: 0 0 190px;

        width: 190px;
        min-width: 190px;

        padding: 10px;
    }

    .history-header h2 {
        font-size: 16px;
    }

    .new-chat-btn {
        padding: 7px 8px;

        font-size: 11px;
    }

    .subjects-toolbar {
        flex-direction: column;
    }

    .subject-count-box {
        width: fit-content;
    }

    .dashboard-ai-banner {
        flex-direction: column;

        align-items: flex-start;
    }

    .ai-banner-btn {
        width: 100%;

        justify-content: center;
    }

    .welcome-content h1 {
        font-size: 23px;
    }

}


/* =========================================================
   45. RESPONSIVE - 520px
========================================================= */

@media (max-width: 520px) {

    #chat-page .chat-history {
        flex: 0 0 180px;

        width: 180px;
        min-width: 180px;
    }

    #chat-page .history-header h2 {
        font-size: 16px;
    }

    #chat-page .new-chat-btn {
        padding: 6px 8px;

        font-size: 10px;
    }

    .subject-modal-box,
    .subject-details-box {
        padding: 18px;

        border-radius: 17px;
    }

}



/* =========================================================
   END OF MASTER SAHAB CSS
========================================================= */